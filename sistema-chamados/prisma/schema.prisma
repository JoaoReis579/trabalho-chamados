generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoPessoa {
  SOLICITANTE
  TECNICO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum SituacaoChamado {
  ABERTO
  EM_ATENDIMENTO
  RESOLVIDO
  FECHADO
  CANCELADO
}

model Pessoa {
  id                 Int         @id @default(autoincrement())
  nome               String      @db.VarChar(120)
  email              String      @unique @db.VarChar(254)
  tipo               TipoPessoa
  ativo              Boolean     @default(true)
  chamadosSolicitados Chamado[]   @relation("Solicitante")
  chamadosTecnicos   Chamado[]   @relation("Tecnico")
  comentarios        Comentario[]
}

model TipoProblema {
  id       Int       @id @default(autoincrement())
  nome     String    @unique @db.VarChar(100)
  ativo    Boolean   @default(true)
  chamados Chamado[]
}

model Chamado {
  id             Int             @id @default(autoincrement())
  titulo         String          @db.VarChar(100)
  descricao      String          @db.Text
  prioridade     Prioridade      @default(MEDIA)
  situacao       SituacaoChamado @default(ABERTO)
  solicitanteId  Int
  tecnicoId      Int?
  tipoProblemaId Int
  criadoEm       DateTime        @default(now())
  resolvidoEm    DateTime?
  solicitante    Pessoa          @relation("Solicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  tecnico        Pessoa?         @relation("Tecnico", fields: [tecnicoId], references: [id], onDelete: Restrict)
  tipoProblema   TipoProblema    @relation(fields: [tipoProblemaId], references: [id], onDelete: Restrict)
  comentarios    Comentario[]
  @@index([situacao, prioridade, tipoProblemaId, tecnicoId])
}

model Comentario {
  id        Int      @id @default(autoincrement())
  texto     String   @db.Text
  chamadoId Int
  autorId   Int
  criadoEm  DateTime @default(now())
  chamado  Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Restrict)
  autor     Pessoa   @relation(fields: [autorId], references: [id], onDelete: Restrict)
  @@index([chamadoId, criadoEm])
}
